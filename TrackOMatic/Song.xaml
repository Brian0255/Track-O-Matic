<UserControl x:Class="TrackOMatic.Song"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrackOMatic"
             xmlns:converters="clr-namespace:TrackOMatic.Converters"
             xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Broadcast;assembly=TrackOMatic.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:SongViewModel}"
             d:DesignHeight="64"
             d:DesignWidth="256"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ResourceKeyConverter x:Key="ResourceKeyConverter" />
            <Style TargetType="Viewbox">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontFamily" Value="Helvetica" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Background="{StaticResource RegionImageBG}">
        <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BaseBG}" Background="{StaticResource RegionImageBG}" />
        <StackPanel Orientation="Horizontal">
            <Image Height="48" Source="{Binding ResourceKey, Converter={StaticResource ResourceKeyConverter}}"/>
            <StackPanel Margin="0,0,0,0">
                <Viewbox>
                    <TextBlock Text="{Binding SongGame}" FontWeight="Light" />
                </Viewbox>
                <Viewbox>
                    <TextBlock Text="{Binding SongName}" FontWeight="Medium" />
                </Viewbox>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
