<UserControl x:Class="TrackOMatic.Song"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrackOMatic"
             xmlns:converters="clr-namespace:TrackOMatic.Converters"
             xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Broadcast;assembly=TrackOMatic.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:SongViewModel}"
             d:DesignHeight="64"
             d:DesignWidth="256"
             Unloaded="OnUnloaded"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ResourceKeyConverter x:Key="ResourceKeyConverter" />
            <Style TargetType="Viewbox">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontFamily" Value="Helvetica" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource RegionImageBG}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border CornerRadius="4" BorderThickness="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource BaseBG}" Background="{StaticResource RegionImageBG}" />

        <Image Grid.Column="0" Stretch="Uniform" MaxHeight="100" Width="Auto" Margin="4" VerticalAlignment="Center" Source="{Binding ResourceKey, Converter={StaticResource ResourceKeyConverter}}"/>
        <Viewbox Grid.Column="1" Margin="8,0,0,0">
            <StackPanel>
                <TextBlock Text="{Binding SongGame}" FontWeight="Light" />
                <TextBlock Text="{Binding SongName}" FontWeight="Medium" />
            </StackPanel>
        </Viewbox>
    </Grid>
</UserControl>
