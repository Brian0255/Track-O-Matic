<Window
    x:Class="TrackOMatic.BroadcastView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic"
    xmlns:broadcast="clr-namespace:TrackOMatic.Broadcast"
    xmlns:enums="clr-namespace:TrackOMatic.Logic.Enums;assembly=TrackOMatic.Logic"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    mc:Ignorable="d"
    Width="470"
    SizeToContent="Height"
    Topmost ="{Binding TopMostSetting, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
    Title="Broadcast View"
    ResizeMode="NoResize"
    Background="{StaticResource VeryDark}"
    Closing="OnClosing"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Image">
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            </Style>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToCollapsedVisibilityConverter" FalseVisibility="Collapsed" />
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Orientation="Vertical" VerticalAlignment="Top">
        <StackPanel.Resources>
            <Style TargetType="broadcast:Item">
                <Setter Property="Margin" Value="1"/>
                <Setter Property="Panel.ZIndex" Value="0"/>
            </Style>
        </StackPanel.Resources>
        <!-- Moves and Levels: could be its own stack panel within a stack panel. -->
        <!-- Consider doing so when we have a dedicated broadcast view model. -->
        <Grid Name="MovesLevels">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="MovesWidth" Width="345"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="7,7,13,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="0*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Name="ShopkeepersRow">
                        <RowDefinition.Style>
                            <Style TargetType="{x:Type RowDefinition}">
                                <Setter Property="Height" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BroadcastShopkeepersSetting, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Height" Value="47" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>
                <Grid Name="MainKongMoves" Grid.Row="0" Visibility="Visible"  Margin="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Kong 1 -->
                    <broadcast:Item Grid.Row="0" Grid.Column="0" ItemName="DONKEY" />
                    <broadcast:Item Grid.Row="0" Grid.Column="1" ItemName="COCONUT_GUN" />
                    <broadcast:Item Grid.Row="0" Grid.Column="2" ItemName="BONGO_BLAST" />
                    <broadcast:Item Grid.Row="0" Grid.Column="3" ItemName="GORILLA_GRAB" />
                    <broadcast:Item Grid.Row="0" Grid.Column="4" ItemName="STRONG_KONG" />
                    <broadcast:Item Grid.Row="0" Grid.Column="5" ItemName="BABOON_BLAST" />

                    <!-- Kong 2 -->
                    <broadcast:Item Grid.Row="1" Grid.Column="0" ItemName="DIDDY" />
                    <broadcast:Item Grid.Row="1" Grid.Column="1" ItemName="PEANUT_POPGUNS" />
                    <broadcast:Item Grid.Row="1" Grid.Column="2" ItemName="GUITAR_GAZUMP" />
                    <broadcast:Item Grid.Row="1" Grid.Column="3" ItemName="CHIMPY_CHARGE" />
                    <broadcast:Item Grid.Row="1" Grid.Column="4" ItemName="ROCKETBARREL_BOOST" />
                    <broadcast:Item Grid.Row="1" Grid.Column="5" ItemName="SIMIAN_SPRING" />

                    <!-- Kong 3 -->
                    <broadcast:Item Grid.Row="2" Grid.Column="0" ItemName="LANKY" />
                    <broadcast:Item Grid.Row="2" Grid.Column="1" ItemName="GRAPE_SHOOTER" />
                    <broadcast:Item Grid.Row="2" Grid.Column="2" ItemName="TROMBONE_TREMOR" />
                    <broadcast:Item Grid.Row="2" Grid.Column="3" ItemName="ORANGSTAND" />
                    <broadcast:Item Grid.Row="2" Grid.Column="4" ItemName="ORANGSTAND_SPRINT" />
                    <broadcast:Item Grid.Row="2" Grid.Column="5" ItemName="BABOON_BALLOON" />

                    <!-- Kong 4 -->
                    <broadcast:Item Grid.Row="3" Grid.Column="0" ItemName="TINY" />
                    <broadcast:Item Grid.Row="3" Grid.Column="1" ItemName="FEATHER_BOW" />
                    <broadcast:Item Grid.Row="3" Grid.Column="2" ItemName="SAXOPHONE_SLAM" />
                    <broadcast:Item Grid.Row="3" Grid.Column="3" ItemName="PONYTAIL_TWIRL" />
                    <broadcast:Item Grid.Row="3" Grid.Column="4" ItemName="MINI_MONKEY" />
                    <broadcast:Item Grid.Row="3" Grid.Column="5" ItemName="MONKEYPORT" />

                    <!-- Kong 5 -->
                    <broadcast:Item Grid.Row="4" Grid.Column="0" ItemName="CHUNKY" />
                    <broadcast:Item Grid.Row="4" Grid.Column="1" ItemName="PINEAPPLE_LAUNCHER" />
                    <broadcast:Item Grid.Row="4" Grid.Column="2" ItemName="TRIANGLE_TRAMPLE" />
                    <broadcast:Item Grid.Row="4" Grid.Column="3" ItemName="PRIMATE_PUNCH" />
                    <broadcast:Item Grid.Row="4" Grid.Column="4" ItemName="HUNKY_CHUNKY" />
                    <broadcast:Item Grid.Row="4" Grid.Column="5" ItemName="GORILLA_GONE" />

                    <!--Blueprints-->
                    <broadcast:KongBlueprint Grid.Row="0" Grid.Column="6" CollectedType="DONKEY_BLUEPRINT" TurnedInType="DONKEY_BLUEPRINT_TURNED" />
                    <broadcast:KongBlueprint Grid.Row="1" Grid.Column="6" CollectedType="DIDDY_BLUEPRINT" TurnedInType="DIDDY_BLUEPRINT_TURNED" />
                    <broadcast:KongBlueprint Grid.Row="2" Grid.Column="6" CollectedType="LANKY_BLUEPRINT" TurnedInType="LANKY_BLUEPRINT_TURNED" />
                    <broadcast:KongBlueprint Grid.Row="3" Grid.Column="6" CollectedType="TINY_BLUEPRINT" TurnedInType="TINY_BLUEPRINT_TURNED" />
                    <broadcast:KongBlueprint Grid.Row="4" Grid.Column="6" CollectedType="CHUNKY_BLUEPRINT" TurnedInType="CHUNKY_BLUEPRINT_TURNED" />
                </Grid>
                <Grid Name="TrainingMovesGrid" Grid.Row="2" Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <broadcast:ProgressiveSlam Grid.Column="0" />
                    <broadcast:Item Grid.Column="1" ItemName="DIVING" />
                    <broadcast:Item Grid.Column="2" ItemName="ORANGE_THROWING" />
                    <broadcast:Item Grid.Column="3" ItemName="BARREL_THROWING" />
                    <broadcast:Item Grid.Column="4" ItemName="VINE_SWINGING" />
                    <broadcast:CameraShockwave Grid.Column="5" />
                    <broadcast:HomingScope Grid.Column="6" />
                </Grid>
                <Grid Name="ShopkeepersGrid" Grid.Row="3" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <broadcast:Item Grid.Column="0" ItemName="CRANKY" />
                    <broadcast:Item Grid.Column="1" ItemName="FUNKY" />
                    <broadcast:Item Grid.Column="2" ItemName="CANDY" />
                    <broadcast:Item Grid.Column="3" ItemName="SNIDE" />
                    <broadcast:Item Grid.Column="4" ItemName="CLIMBING" />
                </Grid>
            </Grid>
            <!-- Broadcast Levels here. -->
            <StackPanel Grid.Column="1" Margin="-6,3,3,3" Height="284" VerticalAlignment="Top">
                <broadcast:Level LevelNumber="1" />
                <broadcast:Level LevelNumber="2" />
                <broadcast:Level LevelNumber="3" />
                <broadcast:Level LevelNumber="4" />
                <broadcast:Level LevelNumber="5" />
                <broadcast:Level LevelNumber="6" />
                <broadcast:Level LevelNumber="7" />
                <broadcast:Level LevelNumber="8" />
                <broadcast:Isles />
            </StackPanel>
        </Grid>
        <!-- End Game items: Blast-O-Matic & Final Boss Order -->
        <Grid Margin="6,1,0,0" Height="47" Visibility="{Binding BroadcastHelmKRoolSetting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width=".2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width=".5*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Images/dk64/lanky_bp.png" Grid.Column="1" Margin="0"/>
                <broadcast:HelmSlot Grid.Column="3" Opacity="1" Margin="0" SlotNumber="0" />
                <broadcast:HelmSlot Grid.Column="4" Opacity="1" Margin="0" SlotNumber="1" />
                <broadcast:HelmSlot Grid.Column="5" Opacity="1" Margin="0" SlotNumber="2" />
                <broadcast:HelmSlot Grid.Column="6" Opacity="1" Margin="0" SlotNumber="3" />
                <broadcast:HelmSlot Grid.Column="7" Opacity="1" Margin="0" SlotNumber="4" />
            </Grid>
            <Grid Grid.Column="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width=".2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width=".5*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Images/dk64/krool.png" Grid.Column="1" Margin="0,0,0,0"/>
                <broadcast:BossSlot Grid.Column="3" Opacity="1" Margin="0" SlotNumber="0" />
                <broadcast:BossSlot Grid.Column="4" Opacity="1" Margin="0" SlotNumber="1" />
                <broadcast:BossSlot Grid.Column="5" Opacity="1" Margin="0" SlotNumber="2" />
                <broadcast:BossSlot Grid.Column="6" Opacity="1" Margin="0" SlotNumber="3" />
                <broadcast:BossSlot Grid.Column="7" Opacity="1" Margin="0" SlotNumber="4" />
            </Grid>
        </Grid>
        <!-- Filler Rectangle -->
        <Rectangle Fill="#131414" Margin="10,6,10,6" Height="5" />
        <!-- Collectibles Grid -->
        <Grid Name="CollectiblesGrid" Margin="30,2,30,9" Height="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <broadcast:Item Grid.Column="0" ItemName="BEAN" />
            <broadcast:Countable Grid.Column="1" ItemType="PEARL" />
            <broadcast:Countable Grid.Column="2" ItemType="BATTLE_CROWN" />
            <broadcast:Countable Grid.Column="3" ItemType="BANANA_MEDAL" />
            <broadcast:Countable Grid.Column="4" ItemType="RAINBOW_COIN" />
            <broadcast:Countable Grid.Column="5" ItemType="FAIRY" />
            <broadcast:Countable Grid.Column="6" ItemType="GOLDEN_BANANA" />
        </Grid>
        <!-- Song Display -->
        <broadcast:Song Background="Transparent" Margin="3,1,3,5" Height="52" Visibility="{Binding BroadcastSongDisplaySetting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}" />
    </StackPanel>
</Window>
