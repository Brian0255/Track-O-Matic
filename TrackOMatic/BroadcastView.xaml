<Window
    x:Class="TrackOMatic.BroadcastView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic"
    xmlns:broadcast="clr-namespace:TrackOMatic.Broadcast"
    xmlns:enums="clr-namespace:TrackOMatic.Logic.Enums;assembly=TrackOMatic.Logic"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Broadcast;assembly=TrackOMatic.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainBroadcastViewModel}"
    Width="470"
    SizeToContent="Height"
    Topmost="{Binding TopMostSetting}"
    Title="Broadcast View"
    ResizeMode="NoResize"
    Background="{StaticResource VeryDark}"
    Closing="OnClosing"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Image">
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            </Style>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToCollapsedVisibilityConverter" FalseVisibility="Collapsed" />
            <ItemsPanelTemplate x:Key="SlotGridPanelTemplate">
                <UniformGrid Rows="1" Columns="5" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Orientation="Vertical" VerticalAlignment="Top">
        <StackPanel.Resources>
            <Style TargetType="broadcast:Item">
                <Setter Property="Margin" Value="1"/>
                <Setter Property="Panel.ZIndex" Value="0"/>
            </Style>
        </StackPanel.Resources>
        <!-- Moves and Levels: could be its own stack panel within a stack panel. -->
        <!-- Consider doing so when we have a dedicated broadcast view model. -->
        <Grid Name="MovesLevels">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding MovesWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="7,7,13,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="0*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Name="ShopkeepersRow">
                        <RowDefinition.Style>
                            <Style TargetType="{x:Type RowDefinition}">
                                <Setter Property="Height" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BroadcastShopkeepersSetting}" Value="True">
                                        <Setter Property="Height" Value="47" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>
                <!-- Main Kong Moves -->
                <Grid Grid.Row="0" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0" Margin="0" ItemsSource="{Binding KongItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="5" Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:BroadcastItemViewModel}">
                                <broadcast:Item />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Column="1" Margin="0" ItemsSource="{Binding KongBlueprints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:KongBlueprintViewModel}">
                                <broadcast:KongBlueprint />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <!-- Training Moves Grid -->
                <Grid Grid.Row="2" Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <broadcast:ProgressiveSlam Grid.Column="0" />
                    <broadcast:Item Grid.Column="1" ItemName="DIVING" />
                    <broadcast:Item Grid.Column="2" ItemName="ORANGE_THROWING" />
                    <broadcast:Item Grid.Column="3" ItemName="BARREL_THROWING" />
                    <broadcast:Item Grid.Column="4" ItemName="VINE_SWINGING" />
                    <broadcast:CameraShockwave Grid.Column="5" />
                    <broadcast:HomingScope Grid.Column="6" />
                </Grid>
                <!-- Shopkeepers Grid -->
                <Grid Name="ShopkeepersGrid" Grid.Row="3" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <broadcast:Item Grid.Column="0" ItemName="CRANKY" />
                    <broadcast:Item Grid.Column="1" ItemName="FUNKY" />
                    <broadcast:Item Grid.Column="2" ItemName="CANDY" />
                    <broadcast:Item Grid.Column="3" ItemName="SNIDE" />
                    <broadcast:Item Grid.Column="4" ItemName="CLIMBING" />
                </Grid>
            </Grid>
            <!-- Broadcast Levels here. -->
            <StackPanel Grid.Column="1" Margin="-6,3,3,3" Height="284" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Levels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewmodels:LevelViewModel}">
                            <broadcast:Level />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <broadcast:Isles />
            </StackPanel>
        </Grid>
        <!-- End Game items: Blast-O-Matic & Final Boss Order -->
        <Grid Margin="6,1,0,0" Height="47" Visibility="{Binding BroadcastHelmKRoolSetting, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width=".2*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width=".5*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Images/dk64/lanky_bp.png" Grid.Column="1" Margin="0"/>
                <ItemsControl Grid.Column="3" Margin="0" ItemsSource="{Binding HelmSlots}" ItemsPanel="{StaticResource SlotGridPanelTemplate}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewmodels:HelmSlotViewModel}">
                            <broadcast:HelmSlot Opacity="1" Margin="0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid Grid.Column="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width=".2*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width=".5*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Images/dk64/krool.png" Grid.Column="1" Margin="0,0,0,0"/>
                <ItemsControl Grid.Column="3" Margin="0" ItemsSource="{Binding BossSlots}" ItemsPanel="{StaticResource SlotGridPanelTemplate}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewmodels:BossSlotViewModel}">
                            <broadcast:BossSlot Opacity="1" Margin="0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
        <!-- Filler Rectangle -->
        <Rectangle Fill="#131414" Margin="10,6,10,6" Height="5" />
        <!-- Collectibles Grid -->
        <Grid Name="CollectiblesGrid" Margin="30,2,30,9" Height="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <broadcast:Item Grid.Column="0" ItemName="BEAN" />
            <broadcast:Countable Grid.Column="1" ItemType="PEARL" />
            <broadcast:Countable Grid.Column="2" ItemType="BATTLE_CROWN" />
            <broadcast:Countable Grid.Column="3" ItemType="BANANA_MEDAL" />
            <broadcast:Countable Grid.Column="4" ItemType="RAINBOW_COIN" />
            <broadcast:Countable Grid.Column="5" ItemType="FAIRY" />
            <broadcast:Countable Grid.Column="6" ItemType="GOLDEN_BANANA" />
        </Grid>
        <!-- Song Display -->
        <Grid Background="Transparent" Margin="3,1,3,5" Height="52" Visibility="{Binding BroadcastSongDisplaySetting, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}">
            <broadcast:Song />
        </Grid>
    </StackPanel>
</Window>
