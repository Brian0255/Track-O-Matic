<UserControl x:Class="TrackOMatic.Regions.RegionLevel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrackOMatic.Regions"
             xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Regions;assembly=TrackOMatic.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:RegionLevelViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="32"
             d:DesignWidth="32"
             MouseLeftButtonDown="RegionLevel_MouseLeftButtonDown"
             MouseRightButtonDown="RegionLevel_MouseRightButtonDown"
             MouseWheel="RegionLevel_MouseWheel"
>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height=".9*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".9*" />
            <ColumnDefinition Width="2.5*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.Column="0" Margin="0">
            <Border CornerRadius="3" Margin="0" Background="{StaticResource BaseBG}">
                <Viewbox HorizontalAlignment="Center">
                    <TextBlock
                        Margin="1,-2,1,1"
                        Panel.ZIndex="2"
                        Foreground="White"
                        FontSize="{StaticResource BigFontSize}"
                        FontFamily="{DynamicResource DK64Font}"
                        TextAlignment="Center"
                        Text="{Binding LevelText}"
                    />
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</UserControl>
