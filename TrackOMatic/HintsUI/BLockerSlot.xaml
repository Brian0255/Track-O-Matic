<UserControl
    x:Class="TrackOMatic.HintsUI.BLockerSlot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic.HintsUI"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Hints;assembly=TrackOMatic.ViewModels"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    Background="Transparent"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:BLockerSlotViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="64"
    d:DesignWidth="64"
    MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
    MouseWheel="UserControl_MouseWheel"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ResourceKeyConverter x:Key="ResourceKeyConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Border
            BorderThickness="0"
            UseLayoutRounding="True"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            RenderOptions.ClearTypeHint="Enabled"
        >
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="0" ShadowDepth="0" BlurRadius="14" Opacity="0.5" />
            </Border.Effect>
            <Image Opacity="1" Source="{Binding ImageResourceKey, Converter={StaticResource ResourceKeyConverter}}" />
        </Border>
    </Grid>
</UserControl>
