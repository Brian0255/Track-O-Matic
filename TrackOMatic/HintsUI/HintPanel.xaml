<UserControl
    x:Class="TrackOMatic.HintsUI.HintPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic.HintsUI"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Hints;assembly=TrackOMatic.ViewModels"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    Background="Transparent"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:HintPanelViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="200"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ResourceKeyConverter x:Key="ResourceKeyConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" FalseVisibility="Collapsed" />
            <Style TargetType="Image">
                <Setter Property="Margin" Value="2,2,2,3" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Border CornerRadius="3" BorderThickness=".5" BorderBrush="Black" Background="{StaticResource VeryDark}">
            <Grid Background="Transparent" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width=".1*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="10,0,0,0" FontSize="18" Foreground="White" FontFamily="{DynamicResource DK64Font}" Text="{Binding Heading}" VerticalAlignment="Center" Padding="0,0,0,2"/>
                    <Image
                        Grid.Column="1"
                        Source="{Binding FilterResourceKey, Converter={StaticResource ResourceKeyConverter}}"
                        Visibility="{Binding IsPathHintPanel, Converter={StaticResource BooleanToVisibilityConverter}}"
                        MouseDown="FilterButton_MouseDown"
                    />
                    <Image
                        Name="SortButton"
                        Grid.Column="2"
                        Source="{Binding SortResourceKey, Converter={StaticResource ResourceKeyConverter}}"
                        Visibility="{Binding IsPathHintPanel, Converter={StaticResource BooleanToVisibilityConverter}}"
                        MouseDown="SortButton_MouseDown"
                    />
                </Grid>
                <Border CornerRadius="1" Grid.Row="1" Margin="0" BorderThickness="0" BorderBrush="Black" Background="{StaticResource RegionImageBG}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <StackPanel Margin="2,0,0,1">
                            <ItemsControl ItemsSource="{Binding HintInfoViewModels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:HintInfo Margin="0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Panel.ZIndex="-1" MouseDown="OnAddHint" Cursor="Hand" Margin="10,5,0,0" Padding="0,5,0,0" Text="+ Add new hint" Foreground="White" FontFamily="Helvetica" FontSize="14" Height="30" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
        <Border CornerRadius="2" BorderThickness="3">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                    <GradientStop Color="{Binding LineColor, RelativeSource={RelativeSource AncestorType=local:HintPanel}}" Offset="0"/>
                    <GradientStop Color="{Binding LineColor, RelativeSource={RelativeSource AncestorType=local:HintPanel}}" Offset="0.007"/>
                    <GradientStop Color="Transparent" Offset="0.008"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
    </Grid>
</UserControl>
