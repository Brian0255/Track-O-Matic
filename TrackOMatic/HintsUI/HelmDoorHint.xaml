<UserControl
    x:Class="TrackOMatic.HintsUI.HelmDoorHint"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic.HintsUI"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Hints;assembly=TrackOMatic.ViewModels"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    Background="Transparent"
    mc:Ignorable="d"
    d:DesignHeight="64"
    d:DesignWidth="96"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ResourceKeyConverter x:Key="ResourceKeyConverter" />
            <converters:BooleanInvertConverter x:Key="BooleanInvertConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="1.75*"/>
            <ColumnDefinition Width=".15*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="White"
            FontSize="16"
            FontFamily="Helvetica"
            Text="{Binding LabelText}"
        />

        <Grid
            Grid.Column="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            DataContext="{Binding SlotViewModel}"
        >
            <local:HelmDoorSlot />
        </Grid>
        <TextBox
            Grid.Column="3"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch"
            FontSize="18"
            ContextMenu="{x:Null}"
            Style="{StaticResource BoldText}"
            Text="{Binding BarrierCount, Mode=OneWay}"
            PreviewMouseLeftButtonDown="OnTextLeftClick"
            PreviewKeyDown="TextBox_PreviewKeyDown"
            LostFocus="TextBox_LostFocus"
        />
    </Grid>
</UserControl>
