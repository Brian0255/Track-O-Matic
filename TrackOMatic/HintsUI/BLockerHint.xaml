<UserControl
    x:Class="TrackOMatic.HintsUI.BLockerHint"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic.HintsUI"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Hints;assembly=TrackOMatic.ViewModels"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    Background="Transparent"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:BLockerHintViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="64"
    d:DesignWidth="96"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ResourceKeyConverter x:Key="ResourceKeyConverter" />
            <converters:BooleanInvertConverter x:Key="BooleanInvertConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="0*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="2.1*"/>
            <ColumnDefinition Width=".1*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Image
            Grid.Row="1"
            Grid.Column="0"
            Margin="0"
            VerticalAlignment="Bottom"
            Source="{Binding RegionResourceKey, Converter={StaticResource ResourceKeyConverter}}"
        />
        <!-- Use the extra child to make data context binding easier. -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Bottom"
            DataContext="{Binding SlotViewModel}"
        >
            <local:BLockerSlot />
        </Grid>
        <TextBox
            Grid.Row="1"
            Grid.Column="3"
            Margin="0,2,0,0"
            VerticalAlignment="Bottom"
            ContextMenu="{x:Null}"
            Style="{StaticResource BoldText}"
            Text="{Binding BarrierCount, Mode=OneWay}"
            IsReadOnly="{Binding IsLocked}"
            Focusable="{Binding IsLocked, Converter={StaticResource BooleanInvertConverter}}"
            PreviewMouseLeftButtonDown="OnTextLeftClick"
            PreviewKeyDown="TextBox_PreviewKeyDown"
            LostFocus="TextBox_LostFocus"
        />
    </Grid>
</UserControl>
