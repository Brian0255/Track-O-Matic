<UserControl
    x:Class="TrackOMatic.HintsUI.HintInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic.HintsUI"
    xmlns:behaviors="clr-namespace:TrackOMatic.HintsUI.Behaviors"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Hints;assembly=TrackOMatic.ViewModels"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:HintInfoViewModel}"
    d:DesignHeight="100"
    d:DesignWidth="200"
    Unloaded="OnUnloaded"
>
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToHiddenVisibilityConverter" FalseVisibility="Hidden" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToCollapsedVisibilityConverter" FalseVisibility="Collapsed" />

        <!-- Style for ListBoxItems in the suggestion dropdown -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <!-- When item has keyboard focus (highlighted but not selected) -->
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#3D5A80"/>
                </Trigger>
                <!-- When item is selected -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2D4A70"/>
                </Trigger>
                <!-- When mouse is over the item -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D5A80"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource RegionBG}" CornerRadius="0" Padding="4,3,3,3" BorderBrush="Black" BorderThickness=".5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsHintInfoPath}" Value="false">
                                    <Setter Property="Height" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsHintInfoPath}" Value="false">
                            <Setter Property="Height" Value="23"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsHintInfoPath}" Value="true">
                            <Setter Property="Height" Value="46"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <TextBox ContextMenu="{x:Null}" Margin="1,0,0,0" PreviewMouseRightButtonDown="Location_PreviewMouseRightButtonDown" PreviewKeyDown="Location_PreviewKeyDown" x:Name="Location" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource BoldText}" Text="{Binding LocationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" behaviors:FocusLocationBehavior.FocusRequest="{Binding ShouldFocusLocation}"/>
            <TextBox ContextMenu="{x:Null}" PreviewMouseRightButtonDown="Location_PreviewMouseRightButtonDown" Margin="0,0,3,0" Grid.Column="1" HorizontalContentAlignment="Right" Style="{StaticResource BoldText}" VerticalAlignment="Center" Visibility="{Binding IsHintInfoPotionCount, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}" Text="{Binding PotionCountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="PotionCount_PreviewKeyDown" behaviors:FocusOnCommandBehavior.FocusRequest="{Binding IsFocusRequested}"/>

            <local:FoundHintItemList Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" DataContext="{Binding FoundHintItemListViewModel}" Visibility="{Binding ShouldShowFocusList, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}"/>
            <local:PathHintItemList Margin="1,0,0,0" Grid.Row="1" DataContext="{Binding PathHintItemListViewModel}" Visibility="{Binding IsHintInfoPath, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}"/>
            <Popup x:Name="SuggestionPopup" Height="120" Width="250" Placement="Bottom" AllowsTransparency="True" IsOpen="{Binding SuggestionBoxIsOpen, Mode=TwoWay}">
                <ListBox Margin="0,0,0,0" FontFamily="Roboto" FontSize="14" Foreground="White" Background="{StaticResource RegionImageBG}" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}" SelectedIndex="{Binding SelectedSuggestionIndex, Mode=TwoWay}" SelectionChanged="SuggestionBox_SelectionChanged" PreviewKeyDown="SuggestionBox_PreviewKeyDown" PreviewMouseDoubleClick="SuggestionBox_PreviewMouseDoubleClick" behaviors:SuggestionListFocusBehavior.FocusFirstItem="{Binding ShouldFocusSuggestionsFirst}" behaviors:TrackFocusWithinBehavior.IsFocusedWithin="{Binding IsSuggestionBoxFocused}"/>
            </Popup>
        </Grid>
    </Border>
</UserControl>
