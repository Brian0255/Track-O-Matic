<UserControl
    x:Class="TrackOMatic.HintsUI.Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic.HintsUI"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Hints;assembly=TrackOMatic.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainHintViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToHiddenVisibilityConverter" FalseVisibility="Hidden" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" FalseVisibility="Collapsed" />
            <converters:CountToRelativeWidthConverter x:Key="CountToRelativeWidthConverter" />

            <Style TargetType="{x:Type local:HintPanel}">
                <Setter Property="Margin" Value="3" />
            </Style>

            <!-- Hint Panel LineColors -->
            <Color x:Key="IslesLineColor">#fff67a</Color>
            <Color x:Key="AztecLineColor">#ffb01f</Color>
            <Color x:Key="GalleonLineColor">#216fff</Color>
            <Color x:Key="CavesLineColor">#42ddf5</Color>
            <Color x:Key="JapesLineColor">#59ff64</Color>
            <Color x:Key="FactoryLineColor">#eeeeee</Color>
            <Color x:Key="ForestLineColor">#006b3e</Color>
            <Color x:Key="CastleLineColor">#99a3ad</Color>
            <Color x:Key="HelmLineColor">#b580ff</Color>
            <Color x:Key="PathsLineColor">#dba512</Color>
            <Color x:Key="FoolishLineColor">#e02f2f</Color>
            <Color x:Key="KongsLineColor">#ff59e1</Color>
            <Color x:Key="WayOfTheHoardLineColor">#2652ff</Color>
            <Color x:Key="PotionCountsLineColor">#d0d0d0</Color>
            <Color x:Key="UnhintedLineColor">#36f77d</Color>
            <Color x:Key="BLockerLineColor">#f0f000</Color>
            <Color x:Key="HelmDoorLineColor">#7d3cbd</Color>

            <!-- DirectHintCompactMode Template -->
            <DataTemplate x:Key="DirectHintCompactModeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <UniformGrid Grid.Column="0" Rows="4" Columns="2">
                        <local:HintPanel DataContext="{Binding IslesHintPanelViewModel}" HintPanelType="Isles" LineColor="{StaticResource IslesLineColor}" />
                        <local:HintPanel DataContext="{Binding JapesHintPanelViewModel}" HintPanelType="Japes" LineColor="{StaticResource JapesLineColor}" />
                        <local:HintPanel DataContext="{Binding AztecHintPanelViewModel}" HintPanelType="Aztec" LineColor="{StaticResource AztecLineColor}" />
                        <local:HintPanel DataContext="{Binding FactoryHintPanelViewModel}" HintPanelType="Factory" LineColor="{StaticResource FactoryLineColor}" />
                        <local:HintPanel DataContext="{Binding GalleonHintPanelViewModel}" HintPanelType="Galleon" LineColor="{StaticResource GalleonLineColor}" />
                        <local:HintPanel DataContext="{Binding ForestHintPanelViewModel}" HintPanelType="Forest" LineColor="{StaticResource ForestLineColor}" />
                        <local:HintPanel DataContext="{Binding CavesHintPanelViewModel}" HintPanelType="Caves" LineColor="{StaticResource CavesLineColor}" />
                        <local:HintPanel DataContext="{Binding CastleHintPanelViewModel}" HintPanelType="Castle" LineColor="{StaticResource CastleLineColor}" />
                    </UniformGrid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2.54*" />
                            <RowDefinition Height="5*" />
                            <RowDefinition Height="2.6*" />
                            <RowDefinition Height="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource CountToRelativeWidthConverter}}" />
                        </Grid.RowDefinitions>
                        <local:HintPanel Grid.Row="0" DataContext="{Binding HelmHintPanelViewModel}" HintPanelType="Helm" LineColor="{StaticResource HelmLineColor}" />
                        <local:HintPanel Grid.Row="1" DataContext="{Binding UnhintedHintPanelViewModel}" HintPanelType="Unhinted" LineColor="{StaticResource UnhintedLineColor}" />
                        <local:BLockerPanel Grid.Row="2" Heading="B. LOCKERS" LineColor="{StaticResource BLockerLineColor}" />
                        <local:HelmDoorPanel Grid.Row="3" Heading="HELM DOORS" LineColor="{StaticResource HelmDoorLineColor}" d:DataContext="{d:DesignInstance Type=viewmodels:HelmDoorPanelViewModel}" Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- DirectHintStandardMode Template -->
            <DataTemplate x:Key="DirectHintStandardModeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <UniformGrid Grid.Column="0" Rows="3" Columns="3">
                        <local:HintPanel DataContext="{Binding IslesHintPanelViewModel}" HintPanelType="Isles" LineColor="{StaticResource IslesLineColor}" />
                        <local:HintPanel DataContext="{Binding JapesHintPanelViewModel}" HintPanelType="Japes" LineColor="{StaticResource JapesLineColor}" />
                        <local:HintPanel DataContext="{Binding AztecHintPanelViewModel}" HintPanelType="Aztec" LineColor="{StaticResource AztecLineColor}" />
                        <local:HintPanel DataContext="{Binding FactoryHintPanelViewModel}" HintPanelType="Factory" LineColor="{StaticResource FactoryLineColor}" />
                        <local:HintPanel DataContext="{Binding GalleonHintPanelViewModel}" HintPanelType="Galleon" LineColor="{StaticResource GalleonLineColor}" />
                        <local:HintPanel DataContext="{Binding ForestHintPanelViewModel}" HintPanelType="Forest" LineColor="{StaticResource ForestLineColor}" />
                        <local:HintPanel DataContext="{Binding CavesHintPanelViewModel}" HintPanelType="Caves" LineColor="{StaticResource CavesLineColor}" />
                        <local:HintPanel DataContext="{Binding CastleHintPanelViewModel}" HintPanelType="Castle" LineColor="{StaticResource CastleLineColor}" />
                        <local:HintPanel Grid.Row="0" DataContext="{Binding HelmHintPanelViewModel}" HintPanelType="Helm" LineColor="{StaticResource HelmLineColor}" />
                    </UniformGrid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*" />
                            <RowDefinition Height="2.6*" />
                            <RowDefinition Height="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource CountToRelativeWidthConverter}}" />
                        </Grid.RowDefinitions>
                        <local:HintPanel Grid.Row="0" DataContext="{Binding UnhintedHintPanelViewModel}" HintPanelType="Unhinted" LineColor="{StaticResource UnhintedLineColor}" />
                        <local:BLockerPanel Grid.Row="1" Heading="B. LOCKERS" LineColor="{StaticResource BLockerLineColor}" />
                        <local:HelmDoorPanel Grid.Row="2" Heading="HELM DOORS" LineColor="{StaticResource HelmDoorLineColor}" d:DataContext="{d:DesignInstance Type=viewmodels:HelmDoorPanelViewModel}" Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- MultipathHintCompactMode Template -->
            <DataTemplate x:Key="MultipathHintCompactModeTemplate">
                <UniformGrid Rows="1" Columns="3">
                    <local:HintPanel DataContext="{Binding PathsHintPanelViewModel}" HintPanelType="Paths" LineColor="{StaticResource PathsLineColor}" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.6*" />
                            <RowDefinition Height="1.25*" />
                            <RowDefinition Height="3*" />
                        </Grid.RowDefinitions>
                        <local:HintPanel Grid.Row="0" DataContext="{Binding FoolishHintPanelViewModel}" HintPanelType="Foolish" LineColor="{StaticResource FoolishLineColor}" />
                        <local:HintPanel Grid.Row="1" DataContext="{Binding KongsHintPanelViewModel}" HintPanelType="Kongs" LineColor="{StaticResource KongsLineColor}" />
                        <local:HintPanel Grid.Row="2" DataContext="{Binding HoardHintPanelViewModel}" HintPanelType="WayOfTheHoard" LineColor="{StaticResource WayOfTheHoardLineColor}" />
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2.54*" />
                            <RowDefinition Height="5*" />
                            <RowDefinition Height="2.6*" />
                            <RowDefinition Height="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource CountToRelativeWidthConverter}}" />
                        </Grid.RowDefinitions>
                        <local:HintPanel Grid.Row="0" DataContext="{Binding PotionHintPanelViewModel}" HintPanelType="PotionCounts" LineColor="{StaticResource PotionCountsLineColor}" />
                        <local:HintPanel Grid.Row="1" DataContext="{Binding UnhintedHintPanelViewModel}" HintPanelType="Unhinted" LineColor="{StaticResource UnhintedLineColor}" />
                        <local:BLockerPanel Grid.Row="2" Heading="B. LOCKERS" LineColor="{StaticResource BLockerLineColor}" />
                        <local:HelmDoorPanel Grid.Row="3" Heading="HELM DOORS" LineColor="{StaticResource HelmDoorLineColor}" d:DataContext="{d:DesignInstance Type=viewmodels:HelmDoorPanelViewModel}" Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </UniformGrid>
            </DataTemplate>

            <!-- MultipathHintStandardMode Template -->
            <DataTemplate x:Key="MultipathHintStandardModeTemplate">
                <UniformGrid Rows="1" Columns="4">
                    <local:HintPanel DataContext="{Binding PathsHintPanelViewModel}" HintPanelType="Paths" LineColor="{StaticResource PathsLineColor}" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.25*" />
                            <RowDefinition Height="3*" />
                        </Grid.RowDefinitions>
                        <local:HintPanel Grid.Row="0" DataContext="{Binding KongsHintPanelViewModel}" HintPanelType="Kongs" LineColor="{StaticResource KongsLineColor}" />
                        <local:HintPanel Grid.Row="1" DataContext="{Binding HoardHintPanelViewModel}" HintPanelType="WayOfTheHoard" LineColor="{StaticResource WayOfTheHoardLineColor}" />
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*" />
                            <RowDefinition Height="3*" />
                        </Grid.RowDefinitions>
                        <local:HintPanel Grid.Row="0" DataContext="{Binding FoolishHintPanelViewModel}" HintPanelType="Foolish" LineColor="{StaticResource FoolishLineColor}" />
                        <local:HintPanel Grid.Row="1" DataContext="{Binding PotionHintPanelViewModel}" HintPanelType="PotionCounts" LineColor="{StaticResource PotionCountsLineColor}" />
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*" />
                            <RowDefinition Height="2.6*" />
                            <RowDefinition Height="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource CountToRelativeWidthConverter}}" />
                        </Grid.RowDefinitions>
                        <local:HintPanel Grid.Row="0" DataContext="{Binding UnhintedHintPanelViewModel}" HintPanelType="Unhinted" LineColor="{StaticResource UnhintedLineColor}" />
                        <local:BLockerPanel Grid.Row="1" Heading="B. LOCKERS" LineColor="{StaticResource BLockerLineColor}" />
                        <local:HelmDoorPanel Grid.Row="2" Heading="HELM DOORS" LineColor="{StaticResource HelmDoorLineColor}" d:DataContext="{d:DesignInstance Type=viewmodels:HelmDoorPanelViewModel}" Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </UniformGrid>
            </DataTemplate>

            <local:HintModeTemplateSelector x:Key="HintModeTemplateSelector"
                DirectHintCompactTemplate="{StaticResource DirectHintCompactModeTemplate}"
                DirectHintStandardTemplate="{StaticResource DirectHintStandardModeTemplate}"
                MultipathHintCompactTemplate="{StaticResource MultipathHintCompactModeTemplate}"
                MultipathHintStandardTemplate="{StaticResource MultipathHintStandardModeTemplate}"
            />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Single ContentPresenter using template selector ensures only one visual tree exists at a time -->
    <!-- The UpdateSourceTrigger ensures ContentTemplateSelector is re-evaluated when CurrentModeKey changes -->
    <ContentPresenter x:Name="ModeContentPresenter" Content="{Binding}" ContentTemplateSelector="{StaticResource HintModeTemplateSelector}" />
</UserControl>
