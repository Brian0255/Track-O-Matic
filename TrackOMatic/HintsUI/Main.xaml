<UserControl
    x:Class="TrackOMatic.HintsUI.Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic.HintsUI"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Hints;assembly=TrackOMatic.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainHintViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToHiddenVisibilityConverter" FalseVisibility="Hidden" />
            <converters:CountToRelativeWidthConverter x:Key="CountToRelativeWidthConverter" />

            <!-- Hint Panel LineColors -->
            <Color x:Key="IslesLineColor">#fff67a</Color>
            <Color x:Key="AztecLineColor">#ffb01f</Color>
            <Color x:Key="GalleonLineColor">#216fff</Color>
            <Color x:Key="CavesLineColor">#42ddf5</Color>
            <Color x:Key="JapesLineColor">#59ff64</Color>
            <Color x:Key="FactoryLineColor">#eeeeee</Color>
            <Color x:Key="ForestLineColor">#006b3e</Color>
            <Color x:Key="CastleLineColor">#99a3ad</Color>
            <Color x:Key="HelmLineColor">#b580ff</Color>
            <Color x:Key="PathsLineColor">#dba512</Color>
            <Color x:Key="FoolishLineColor">#e02f2f</Color>
            <Color x:Key="KongsLineColor">#ff59e1</Color>
            <Color x:Key="WayOfTheHoardLineColor">#2652ff</Color>
            <Color x:Key="PotionCountsLineColor">#d0d0d0</Color>
            <Color x:Key="UnhintedLineColor">#36f77d</Color>
            <Color x:Key="BLockerLineColor">#f0f000</Color>
            <Color x:Key="HelmDoorLineColor">#7d3cbd</Color>
        </ResourceDictionary>
        <Style TargetType="{x:Type local:HintPanel}">
            <Setter Property="Margin" Value="3" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid Visibility="{Binding IsDirectHintCompactMode, Converter={StaticResource BooleanToHiddenVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <UniformGrid Grid.Column="0" Rows="4" Columns="2">
                <local:HintPanel HintPanelType="Isles" HintType="DIRECT_ITEM_HINT" Heading="ISLES" LineColor="{StaticResource IslesLineColor}" RegionName="DK_ISLES" />
                <local:HintPanel HintPanelType="Japes" HintType="DIRECT_ITEM_HINT" Heading="JAPES" LineColor="{StaticResource JapesLineColor}" RegionName="JUNGLE_JAPES" />
                <local:HintPanel HintPanelType="Aztec" HintType="DIRECT_ITEM_HINT" Heading="AZTEC" LineColor="{StaticResource AztecLineColor}" RegionName="ANGRY_AZTEC" />
                <local:HintPanel HintPanelType="Factory" HintType="DIRECT_ITEM_HINT" Heading="FACTORY" LineColor="{StaticResource FactoryLineColor}" RegionName="FRANTIC_FACTORY" />
                <local:HintPanel HintPanelType="Galleon" HintType="DIRECT_ITEM_HINT" Heading="GALLEON" LineColor="{StaticResource GalleonLineColor}" RegionName="GLOOMY_GALLEON" />
                <local:HintPanel HintPanelType="Forest" HintType="DIRECT_ITEM_HINT" Heading="FOREST" LineColor="{StaticResource ForestLineColor}" RegionName="FUNGI_FOREST" />
                <local:HintPanel HintPanelType="Caves" HintType="DIRECT_ITEM_HINT" Heading="CAVES" LineColor="{StaticResource CavesLineColor}" RegionName="CRYSTAL_CAVES" />
                <local:HintPanel HintPanelType="Castle" HintType="DIRECT_ITEM_HINT" Heading="CASTLE" LineColor="{StaticResource CastleLineColor}" RegionName="CREEPY_CASTLE" />
            </UniformGrid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.54*" />
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="2.6*" />
                    <RowDefinition Height="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource CountToRelativeWidthConverter}}" />
                </Grid.RowDefinitions>
                <local:HintPanel Grid.Row="0" HintPanelType="Helm" HintType="DIRECT_ITEM_HINT" Heading="HELM" LineColor="{StaticResource HelmLineColor}" RegionName="HIDEOUT_HELM"  />
                <local:HintPanel Grid.Row="1" HintPanelType="Unhinted" HintType="UNHINTED" Heading="UNHINTED MOVES" LineColor="{StaticResource UnhintedLineColor}" />
                <local:BLockerPanel Grid.Row="2" Heading="B. LOCKERS" LineColor="{StaticResource BLockerLineColor}" />
                <local:HelmDoorPanel Grid.Row="3" Heading="HELM DOORS" LineColor="{StaticResource HelmDoorLineColor}" Visibility="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" />
            </Grid>
        </Grid>
        <Grid Visibility="{Binding IsDirectHintStandardMode, Converter={StaticResource BooleanToHiddenVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <UniformGrid Grid.Column="0" Rows="3" Columns="3">
                <local:HintPanel HintPanelType="Isles" HintType="DIRECT_ITEM_HINT" Heading="ISLES" LineColor="{StaticResource IslesLineColor}" RegionName="DK_ISLES" />
                <local:HintPanel HintPanelType="Japes" HintType="DIRECT_ITEM_HINT" Heading="JAPES" LineColor="{StaticResource JapesLineColor}" RegionName="JUNGLE_JAPES" />
                <local:HintPanel HintPanelType="Aztec" HintType="DIRECT_ITEM_HINT" Heading="AZTEC" LineColor="{StaticResource AztecLineColor}" RegionName="ANGRY_AZTEC" />
                <local:HintPanel HintPanelType="Factory" HintType="DIRECT_ITEM_HINT" Heading="FACTORY" LineColor="{StaticResource FactoryLineColor}" RegionName="FRANTIC_FACTORY" />
                <local:HintPanel HintPanelType="Galleon" HintType="DIRECT_ITEM_HINT" Heading="GALLEON" LineColor="{StaticResource GalleonLineColor}" RegionName="GLOOMY_GALLEON" />
                <local:HintPanel HintPanelType="Forest" HintType="DIRECT_ITEM_HINT" Heading="FOREST" LineColor="{StaticResource ForestLineColor}" RegionName="FUNGI_FOREST" />
                <local:HintPanel HintPanelType="Caves" HintType="DIRECT_ITEM_HINT" Heading="CAVES" LineColor="{StaticResource CavesLineColor}" RegionName="CRYSTAL_CAVES" />
                <local:HintPanel HintPanelType="Castle" HintType="DIRECT_ITEM_HINT" Heading="CASTLE" LineColor="{StaticResource CastleLineColor}" RegionName="CREEPY_CASTLE" />
                <local:HintPanel Grid.Row="0" HintPanelType="Helm" HintType="DIRECT_ITEM_HINT" Heading="HELM" LineColor="{StaticResource HelmLineColor}" RegionName="HIDEOUT_HELM"  />
            </UniformGrid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="2.6*" />
                    <RowDefinition Height="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource CountToRelativeWidthConverter}}" />
                </Grid.RowDefinitions>
                <local:HintPanel Grid.Row="1" HintPanelType="Unhinted" HintType="UNHINTED" Heading="UNHINTED MOVES" LineColor="{StaticResource UnhintedLineColor}" />
                <local:BLockerPanel Grid.Row="2" Heading="B. LOCKERS" LineColor="{StaticResource BLockerLineColor}" />
                <local:HelmDoorPanel Grid.Row="3" Heading="HELM DOORS" LineColor="{StaticResource HelmDoorLineColor}" Visibility="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" />
            </Grid>
        </Grid>
        <UniformGrid Rows="1" Columns="3" Visibility="{Binding IsMultipathCompactMode, Converter={StaticResource BooleanToHiddenVisibilityConverter}}">
            <local:HintPanel HintPanelType="Paths" HintType="PATH" Heading="PATHS" LineColor="{StaticResource PathsLineColor}" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.6*"/>
                    <RowDefinition Height="1.25*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>
                <local:HintPanel Grid.Row="0" HintPanelType="Foolish" HintType="FOOLISH_REGION" Heading="FOOLISH REGIONS" LineColor="{StaticResource FoolishLineColor}" />
                <local:HintPanel Grid.Row="1" HintPanelType="Kongs" HintType="KONGS" Heading="KONGS" LineColor="{StaticResource KongsLineColor}" />
                <local:HintPanel Grid.Row="2" HintPanelType="WayOfTheHoard" HintType="WAY_OF_THE_HOARD" Heading="WAY OF THE HOARD" LineColor="{StaticResource WayOfTheHoardLineColor}" />
            </Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.54*" />
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="2.6*" />
                    <RowDefinition Height="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource CountToRelativeWidthConverter}}" />
                </Grid.RowDefinitions>
                <local:HintPanel Grid.Row="0" HintPanelType="PotionCounts" HintType="REGION_POTION_COUNT" Heading="POTION COUNTS" LineColor="{StaticResource PotionCountsLineColor}" />
                <local:HintPanel Grid.Row="1" HintPanelType="Unhinted" HintType="UNHINTED" Heading="UNHINTED MOVES" LineColor="{StaticResource UnhintedLineColor}" />
                <local:BLockerPanel Grid.Row="2" Heading="B. LOCKERS" LineColor="{StaticResource BLockerLineColor}" />
                <local:HelmDoorPanel Grid.Row="3" Heading="HELM DOORS" LineColor="{StaticResource HelmDoorLineColor}" Visibility="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" />
            </Grid>
        </UniformGrid>
        <UniformGrid Rows="1" Columns="4" Visibility="{Binding IsMultipathStandardMode, Converter={StaticResource BooleanToHiddenVisibilityConverter}}">
            <local:HintPanel HintPanelType="Paths" HintType="PATH" Heading="PATHS" LineColor="{StaticResource PathsLineColor}" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.25*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <local:HintPanel Grid.Row="0" HintPanelType="Kongs" HintType="KONGS" Heading="KONGS" LineColor="{StaticResource KongsLineColor}" />
                <local:HintPanel Grid.Row="1" HintPanelType="WayOfTheHoard" HintType="WAY_OF_THE_HOARD" Heading="WAY OF THE HOARD" LineColor="{StaticResource WayOfTheHoardLineColor}" />
            </Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <local:HintPanel Grid.Row="0" HintPanelType="Foolish" HintType="FOOLISH_REGION" Heading="FOOLISH REGIONS" LineColor="{StaticResource FoolishLineColor}" />
                <local:HintPanel Grid.Row="1" HintPanelType="PotionCounts" HintType="REGION_POTION_COUNT" Heading="POTION COUNTS" LineColor="{StaticResource PotionCountsLineColor}" />
            </Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="2.6*" />
                    <RowDefinition Height="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource CountToRelativeWidthConverter}}" />
                </Grid.RowDefinitions>
                <local:HintPanel Grid.Row="1" HintPanelType="Unhinted" HintType="UNHINTED" Heading="UNHINTED MOVES" LineColor="{StaticResource UnhintedLineColor}" />
                <local:BLockerPanel Grid.Row="2" Heading="B. LOCKERS" LineColor="{StaticResource BLockerLineColor}" />
                <local:HelmDoorPanel Grid.Row="3" Heading="HELM DOORS" LineColor="{StaticResource HelmDoorLineColor}" Visibility="{Binding IsHelmDoorPanelEnabled, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" />
            </Grid>
        </UniformGrid>
    </Grid>
</UserControl>
