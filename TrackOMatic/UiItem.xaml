<UserControl
    x:Class="TrackOMatic.UiItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels;assembly=TrackOMatic.ViewModels"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    Background="Transparent"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:UiItemViewModel}"
    d:DesignHeight="64"
    d:DesignWidth="64"
    MouseWheel="UiItem_MouseWheel"
    PreviewMouseDown="UiItem_PreviewMouseDown"
    PreviewMouseMove="UiItem_PreviewMouseMove"
    PreviewMouseUp="UiItem_PreviewMouseUp"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToCollapsedVisibilityConverter" FalseVisibility="Collapsed" />
            <converters:ResourceKeyConverter x:Key="ResourceKeyConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border
            BorderThickness="0"
            UseLayoutRounding="True"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            RenderOptions.ClearTypeHint="Enabled"
            ToolTipService.InitialShowDelay="500"
            ToolTipService.HasDropShadow="True"
            Opacity="{Binding Opacity}"
        >
            <Border.ToolTip>
                <ToolTip
                    Content="{Binding HoverText}"
                    Visibility="{Binding HasHoverText, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}"
                    Placement="Mouse"
                />
            </Border.ToolTip>
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="0" ShadowDepth="0" BlurRadius="14" Opacity="0.5" />
            </Border.Effect>
            <Image Source="{Binding ImageResourceKey, Converter={StaticResource ResourceKeyConverter}}" />
        </Border>
        <Image
            Margin="0,0,4,4"
            Source="{StaticResource star_complex}"
            HorizontalAlignment="Left"
            IsHitTestVisible="False"
            Visibility="{Binding IsStarred, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}" />
    </Grid>
</UserControl>
