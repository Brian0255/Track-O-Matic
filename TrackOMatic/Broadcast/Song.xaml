<UserControl
    x:Class="TrackOMatic.Broadcast.Song"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TrackOMatic"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Broadcast;assembly=TrackOMatic.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:SongViewModel}"
    d:DesignHeight="64"
    d:DesignWidth="256"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ResourceKeyConverter x:Key="ResourceKeyConverter" />
            <Style TargetType="Viewbox">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontFamily" Value="Helvetica" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border CornerRadius="5" BorderThickness="1" BorderBrush="#131414" Background="#1a1b1c" />
        <StackPanel Orientation="Horizontal">
            <Image
                Height="48"
                Margin="3"
                Panel.ZIndex="2"
                Opacity="1"
                HorizontalAlignment="Center"
                Source="{Binding ResourceKey, Converter={StaticResource ResourceKeyConverter}}"
            />
            <StackPanel Margin="6,0,0,0">
                <TextBlock Margin="0,4,0,1" Text="{Binding SongGame}" FontWeight="Light" />
                <TextBlock Margin="0,1,0,4" Text="{Binding SongName}" FontWeight="Medium" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
