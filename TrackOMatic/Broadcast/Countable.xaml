<UserControl x:Class="TrackOMatic.Broadcast.Countable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels.Broadcast;assembly=TrackOMatic.ViewModels"
             xmlns:converters="clr-namespace:TrackOMatic.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:CountableViewModel}"
             d:DesignHeight="64"
             d:DesignWidth="64"
             Unloaded="OnUnloaded"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" FalseVisibility="Hidden" />
            <converters:ResourceKeyConverter x:Key="ResourceKeyConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Viewbox Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" Panel.ZIndex="2">
            <Grid Background="Black" Height="12" Width="12" Visibility="{Binding Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock
                    Foreground="White"
                    Margin="0,-1,0,0"
                    FontSize="10"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource DK64Font}"
                    Text="{Binding Count, StringFormat={}{0}}"
                />
            </Grid>
        </Viewbox>
        <Image
            Margin="2"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Source="{Binding ImageResourceKey, Converter={StaticResource ResourceKeyConverter}}"
        >
            <Image.Effect>
                <DropShadowEffect Color="Black" Direction="0" ShadowDepth="0" BlurRadius="14" Opacity="0.5" />
            </Image.Effect>
        </Image>
    </Grid>
</UserControl>
