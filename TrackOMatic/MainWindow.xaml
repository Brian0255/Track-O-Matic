<Window
    x:Class="TrackOMatic.MainWindow"
    x:Name="MainWindowRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:TrackOMatic"
    xmlns:hints="clr-namespace:TrackOMatic.HintsUI"
    xmlns:regions="clr-namespace:TrackOMatic.Regions"
    xmlns:enums="clr-namespace:TrackOMatic.Logic.Enums;assembly=TrackOMatic.Logic"
    xmlns:converters="clr-namespace:TrackOMatic.Converters"
    xmlns:viewmodels="clr-namespace:TrackOMatic.ViewModels;assembly=TrackOMatic.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
    ResizeMode="CanResize"
    Closing="Window_Closing"
    Loaded="MainWindow_Loaded"
    LocationChanged="Window_LocationChanged"
    MouseDown="rootGrid_LostFocus"
    SizeChanged="Window_SizeChanged"
    AllowDrop="True"
    Drop="DropFile"
    Title="Track-O-Matic"
    Height="820"
    Width="1800"
    Background="{StaticResource RegionBG}"
    MinHeight="300"
    MinWidth="300"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Image">
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="CaretBrush" Value="White"/>
            </Style>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToHiddenVisibilityConverter" FalseVisibility="Hidden" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToCollapsedVisibilityConverter" FalseVisibility="Collapsed" />
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="File" Focusable="False">
                <MenuItem Header="Open Spoiler Log" StaysOpenOnClick="True"  Click="OpenSpoiler"/>
                <MenuItem Header="Reset Size" StaysOpenOnClick="True"  Click="ResetSize"/>
                <MenuItem Header="Reset Tracker" StaysOpenOnClick="True"  Click="OnReset"/>
                <MenuItem Header="Save Data" StaysOpenOnClick="True"  Click="OnSave"/>
                <MenuItem Header="Load Data" StaysOpenOnClick="True"  Click="OnLoad"/>
            </MenuItem>
            <MenuItem Header="Toggles" Focusable="False">
                <MenuItem Name="TopMostOption" Header="Always on Top" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsTopMostEnabled, Mode=OneWay}" Command="{Binding ToggleTopMostCommand}" />
                <MenuItem Name="AutotrackOption" Header="Autotracking" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsAutotrackingEnabled, Mode=OneWay}" Command="{Binding ToggleAutotrackingCommand}" />
                <MenuItem Name="SongDisplayOption" Header="Song Display" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsSongDisplayEnabled, Mode=OneWay}" Command="{Binding ToggleSongDisplayCommand}" />
                <MenuItem Name="HelmInLevelOrder" Header="Helm in Level Order" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsHelmInLevelOrderEnabled, Mode=OneWay}" Command="{Binding ToggleHelmInLevelOrderCommand}" />
                <MenuItem Name="ColorBarrelPadMoves" Header="Colored Barrel &amp; Pad Moves" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsColoredBarrelPadMovesEnabled, Mode=OneWay}" Command="{Binding ToggleColoredBarrelPadMovesCommand}" />
                <MenuItem Name="CollectiblesDisplayOption" Header="Collectibles">
                    <MenuItem Name="TotalBPs" Header="Total Blueprints" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsTotalBlueprintCollectibleEnabled, Mode=OneWay}" Command="{Binding ToggleTotalBlueprintCollectibleCommand}" />
                    <MenuItem Name="CompanyCoins" Header="Company Coins" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsCompanyCoinCollectibleEnabled, Mode=OneWay}" Command="{Binding ToggleCompanyCoinCollectibleCommand}" />
                </MenuItem>
                <MenuItem Name="SpoilerHintsOption" Header="Spoiler Hints">
                    <MenuItem Name="KRoolOrder" Header="K. Rool Order" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsShowingHelmSpoilerInfoEnabled, Mode=OneWay}" Command="{Binding ToggleHelmSpoilerOrderCommand}" />
                    <MenuItem Name="HelmOrder" Header="Helm Order" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsShowingBossSpoilerInfoEnabled, Mode=OneWay}" Command="{Binding ToggleBossSpoilerOrderCommand}" />
                </MenuItem>
                <MenuItem Name="ProgHintOption" Header="Progressive Hints">
                    <MenuItem Name="ProgHintShowAmount" Header="Show Amount for Next Hint Pack" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsProgressiveHintCounterEnabled, Mode=OneWay}" Command="{Binding ToggleProgressiveHintCounterCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Hint Display" Focusable="False">
                <RadioButton GroupName="HintDisplay" Name="hintDisplayOff" IsChecked="{Binding HintDisplayMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:HintDisplayMode.Off}}" Command="{Binding SetHintDisplayCommand}" CommandParameter="{x:Static enums:HintDisplayMode.Off}">Off</RadioButton>
                <RadioButton GroupName="HintDisplay" Name="hintDisplayMP" IsChecked="{Binding HintDisplayMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:HintDisplayMode.MultipathHints}}" Command="{Binding SetHintDisplayCommand}" CommandParameter="{x:Static enums:HintDisplayMode.MultipathHints}">Multipath Hints</RadioButton>
                <RadioButton GroupName="HintDisplay" Name="hintDisplayDirect" IsChecked="{Binding HintDisplayMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:HintDisplayMode.DirectItemHints}}" Command="{Binding SetHintDisplayCommand}" CommandParameter="{x:Static enums:HintDisplayMode.DirectItemHints}">Direct Item Hints</RadioButton>
                <MenuItem Name="HelmDoors" Header="Helm Doors" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsHelmDoorPanelEnabled, Mode=OneWay}" Command="{Binding ToggleHelmDoorPanelCommand}" />
                <MenuItem Name="CompactOption" Header="Compact Mode" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsCompactModeEnabled, Mode=OneWay}" Command="{Binding ToggleCompactModeCommand}" />
                <MenuItem Name="SortNewHintsOption" Header="Sort New Path Hints By Length" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsSortablePathHintsEnabled, Mode=OneWay}" Command="{Binding ToggleSortablePathHintsCommand}" />
                <MenuItem Name="EnemiesInAutofillOption" Header="Include Enemies in Hint Searches" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsEnemySearchEnabled, Mode=OneWay}" Command="{Binding ToggleEnemySearchCommand}" />
            </MenuItem>
            <MenuItem Header="Broadcast View" Focusable="False">
                <MenuItem Name="BroadcastOption" StaysOpenOnClick="True" Header="Active" IsCheckable="True" IsChecked="{Binding IsBroadcastViewEnabled, Mode=OneWay}" Command="{Binding ToggleBroadcastViewCommand}" />
                <MenuItem Name="BroadcastCustomize" Header="Main Options">
                    <MenuItem Name="BroadcastHelmKRool" Header='Helm &amp; K. Rool' IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsBroadcastHelmKRoolEnabled, Mode=OneWay}" Command="{Binding ToggleBroadcastHelmKRoolCommand}" />
                    <MenuItem Name="BroadcastShopkeepers" Header="Shopkeepers" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsBroadcastShopkeepersEnabled, Mode=OneWay}" Command="{Binding ToggleBroadcastShopkeepersCommand}" />
                    <MenuItem Name="BroadcastSongDisplay" Header="Song Display" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding IsBroadcastSongDisplayEnabled, Mode=OneWay}" Command="{Binding ToggleBroadcastSongDisplayCommand}" />
                </MenuItem>
                <MenuItem Name="BroadcastNumberDisplayOption" Header="Number Display">
                    <RadioButton GroupName="BroadcastNumberDisplay" Name="broadcastNumberDisplayPoints" IsChecked="{Binding BroadcastNumberLabel, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:BroadcastNumberLabel.Points}}" Command="{Binding SetBroadcastNumberLabelCommand}" CommandParameter="{x:Static enums:BroadcastNumberLabel.Points}">Points</RadioButton>
                    <RadioButton GroupName="BroadcastNumberDisplay" Name="broadcastNumberDisplayWOTHCount" IsChecked="{Binding BroadcastNumberLabel, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:BroadcastNumberLabel.WothCount}}" Command="{Binding SetBroadcastNumberLabelCommand}" CommandParameter="{x:Static enums:BroadcastNumberLabel.WothCount}">WOTH Count</RadioButton>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Version 3.0.0" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Right"/>
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition x:Name="HintsColumn" Width="1.43*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height=".007*"/>
                    <RowDefinition Height=".1*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height=".4*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height=".1*"/>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="{x:Type RowDefinition}">
                                <Setter Property="Height" Value=".01*" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSongDisplayEnabled, ElementName=MainWindowRoot}" Value="False">
                                        <Setter Property="Height" Value="0"  />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="{x:Type RowDefinition}">
                                <Setter Property="Height" Value=".12*" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSongDisplayEnabled, ElementName=MainWindowRoot}" Value="False">
                                        <Setter Property="Height" Value="0"  />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Rectangle Fill="{StaticResource BaseBG}" />
                </Grid>
                <Grid Grid.Row="3">
                    <Rectangle Fill="{StaticResource RegionImageBG}" Margin="10,6,10,6"  />
                </Grid>
                <Grid Grid.Row="5">
                    <Rectangle Fill="{StaticResource RegionImageBG}" Margin="10,6,10,6"  />
                </Grid>
                <!-- Region Grid -->
                <Grid Grid.Row="0"  Background="{StaticResource BaseBG}">
                    <Grid.Resources>
                        <Style TargetType="{x:Type regions:UiRegion}">
                            <Setter Property="Margin" Value="1"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <regions:UiRegion Grid.Row="0" Grid.Column="0" RegionName="START" />
                        <regions:UiRegion Grid.Row="1" Grid.Column="0" RegionName="JUNGLE_JAPES" />
                        <regions:UiRegion Grid.Row="2" Grid.Column="0" RegionName="ANGRY_AZTEC" />
                        <regions:UiRegion Grid.Row="3" Grid.Column="0" RegionName="FRANTIC_FACTORY" />
                        <regions:UiRegion Grid.Row="4" Grid.Column="0" RegionName="GLOOMY_GALLEON" />

                        <regions:UiRegion Grid.Row="0" Grid.Column="1" RegionName="DK_ISLES" />
                        <regions:UiRegion Grid.Row="1" Grid.Column="1" RegionName="FUNGI_FOREST" />
                        <regions:UiRegion Grid.Row="2" Grid.Column="1" RegionName="CRYSTAL_CAVES" />
                        <regions:UiRegion Grid.Row="3" Grid.Column="1" RegionName="CREEPY_CASTLE" />
                        <regions:UiRegion Grid.Row="4" Grid.Column="1" RegionName="HIDEOUT_HELM" />
                    </Grid>
                </Grid>

                <!--GB/other stuff display-->
                <local:CollectiblesGridRow Grid.Row="2" />
                <!-- Items -->
                <Grid Name="ItemGrid" Grid.Row="4" Visibility="Visible"  Margin="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Name="ItemsSeparator" Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Name="ShopkeeperColumn" Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Kong 1 -->
                    <local:UiItem Grid.Row="0" Grid.Column="0" ItemName="DONKEY" />
                    <local:UiItem Grid.Row="0" Grid.Column="1" ItemName="COCONUT_GUN" />
                    <local:UiItem Grid.Row="0" Grid.Column="2" ItemName="BONGO_BLAST" />
                    <local:UiItem Grid.Row="0" Grid.Column="3" ItemName="GORILLA_GRAB" />
                    <local:UiItem Grid.Row="0" Grid.Column="4" ItemName="STRONG_KONG" />
                    <local:UiItem Grid.Row="0" Grid.Column="5" ItemName="BABOON_BLAST" />

                    <!-- Kong 2 -->
                    <local:UiItem Grid.Row="1" Grid.Column="0" ItemName="DIDDY" />
                    <local:UiItem Grid.Row="1" Grid.Column="1" ItemName="PEANUT_POPGUNS" />
                    <local:UiItem Grid.Row="1" Grid.Column="2" ItemName="GUITAR_GAZUMP" />
                    <local:UiItem Grid.Row="1" Grid.Column="3" ItemName="CHIMPY_CHARGE" />
                    <local:UiItem Grid.Row="1" Grid.Column="4" ItemName="ROCKETBARREL_BOOST" />
                    <local:UiItem Grid.Row="1" Grid.Column="5" ItemName="SIMIAN_SPRING" />

                    <!-- Kong 3 -->
                    <local:UiItem Grid.Row="2" Grid.Column="0" ItemName="LANKY" />
                    <local:UiItem Grid.Row="2" Grid.Column="1" ItemName="GRAPE_SHOOTER" />
                    <local:UiItem Grid.Row="2" Grid.Column="2" ItemName="TROMBONE_TREMOR" />
                    <local:UiItem Grid.Row="2" Grid.Column="3" ItemName="ORANGSTAND" />
                    <local:UiItem Grid.Row="2" Grid.Column="4" ItemName="ORANGSTAND_SPRINT" />
                    <local:UiItem Grid.Row="2" Grid.Column="5" ItemName="BABOON_BALLOON" />

                    <!-- Kong 4 -->
                    <local:UiItem Grid.Row="3" Grid.Column="0" ItemName="TINY" />
                    <local:UiItem Grid.Row="3" Grid.Column="1" ItemName="FEATHER_BOW" />
                    <local:UiItem Grid.Row="3" Grid.Column="2" ItemName="SAXOPHONE_SLAM" />
                    <local:UiItem Grid.Row="3" Grid.Column="3" ItemName="PONYTAIL_TWIRL" />
                    <local:UiItem Grid.Row="3" Grid.Column="4" ItemName="MINI_MONKEY" />
                    <local:UiItem Grid.Row="3" Grid.Column="5" ItemName="MONKEYPORT" />

                    <!-- Kong 5 -->
                    <local:UiItem Grid.Row="4" Grid.Column="0" ItemName="CHUNKY" />
                    <local:UiItem Grid.Row="4" Grid.Column="1" ItemName="PINEAPPLE_LAUNCHER" />
                    <local:UiItem Grid.Row="4" Grid.Column="2" ItemName="TRIANGLE_TRAMPLE" />
                    <local:UiItem Grid.Row="4" Grid.Column="3" ItemName="PRIMATE_PUNCH" />
                    <local:UiItem Grid.Row="4" Grid.Column="4" ItemName="HUNKY_CHUNKY" />
                    <local:UiItem Grid.Row="4" Grid.Column="5" ItemName="GORILLA_GONE" />

                    <!--Blueprints-->
                    <local:KongBlueprint Grid.Row="0" Grid.Column="6" CollectedType="DONKEY_BLUEPRINT" TurnedInType="DONKEY_BLUEPRINT_TURNED" />
                    <local:KongBlueprint Grid.Row="1" Grid.Column="6" CollectedType="DIDDY_BLUEPRINT" TurnedInType="DIDDY_BLUEPRINT_TURNED" />
                    <local:KongBlueprint Grid.Row="2" Grid.Column="6" CollectedType="LANKY_BLUEPRINT" TurnedInType="LANKY_BLUEPRINT_TURNED" />
                    <local:KongBlueprint Grid.Row="3" Grid.Column="6" CollectedType="TINY_BLUEPRINT" TurnedInType="TINY_BLUEPRINT_TURNED" />
                    <local:KongBlueprint Grid.Row="4" Grid.Column="6" CollectedType="CHUNKY_BLUEPRINT" TurnedInType="CHUNKY_BLUEPRINT_TURNED" />

                    <!-- Keys-->
                    <local:UiItem Grid.Row="0" Grid.Column="8" ItemName="KEY_1" />
                    <local:UiItem Grid.Row="0" Grid.Column="9" ItemName="KEY_2" />
                    <local:UiItem Grid.Row="0" Grid.Column="10" ItemName="KEY_3" />
                    <local:UiItem Grid.Row="0" Grid.Column="11" ItemName="KEY_4" />
                    <local:UiItem Grid.Row="1" Grid.Column="8" ItemName="KEY_5" />
                    <local:UiItem Grid.Row="1" Grid.Column="9" ItemName="KEY_6" />
                    <local:UiItem Grid.Row="1" Grid.Column="10" ItemName="KEY_7" />
                    <local:UiItem Grid.Row="1" Grid.Column="11" ItemName="KEY_8" />

                    <!--Slams/Bean-->
                    <local:UiItem Grid.Row="2" Grid.Column="8" ItemName="PROGRESSIVE_SLAM_1" />
                    <local:UiItem Grid.Row="2" Grid.Column="9" ItemName="PROGRESSIVE_SLAM_2" />
                    <local:UiItem Grid.Row="2" Grid.Column="10" ItemName="PROGRESSIVE_SLAM_3" />
                    <local:UiItem Grid.Row="2" Grid.Column="11" ItemName="BEAN" />

                    <!--Training Moves-->
                    <local:UiItem Grid.Row="4" Grid.Column="8" ItemName="DIVING" />
                    <local:UiItem Grid.Row="4" Grid.Column="9" ItemName="ORANGE_THROWING" />
                    <local:UiItem Grid.Row="4" Grid.Column="10" ItemName="BARREL_THROWING" />
                    <local:UiItem Grid.Row="4" Grid.Column="11" ItemName="VINE_SWINGING" />
                    <local:UiItem Grid.Row="4" Grid.Column="12" ItemName="CLIMBING" />

                    <!--Sniper/Homing/Camera/Shockwave-->
                    <local:UiItem Grid.Row="3" Grid.Column="8" ItemName="SNIPER_SCOPE" />
                    <local:UiItem Grid.Row="3" Grid.Column="9" ItemName="HOMING_AMMO" />
                    <local:UiItem Grid.Row="3" Grid.Column="10" ItemName="FAIRY_CAMERA" />
                    <local:UiItem Grid.Row="3" Grid.Column="11" ItemName="SHOCKWAVE" />

                    <!--Shopkeepers-->
                    <local:UiItem Grid.Row="0" Grid.Column="12" ItemName="CRANKY" />
                    <local:UiItem Grid.Row="1" Grid.Column="12" ItemName="CANDY" />
                    <local:UiItem Grid.Row="2" Grid.Column="12" ItemName="FUNKY" />
                    <local:UiItem Grid.Row="3" Grid.Column="12" ItemName="SNIDE" />
                </Grid>
                <!--K.Rool/Helm order-->
                <Grid Grid.Row="6" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="8,1,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width=".3*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="HelmLabel" Source="Images/dk64/lanky_bp.png" Grid.Column="0" Margin="-1"/>
                        <local:HelmSlot Grid.Column="2" Opacity="1" Margin="1" SlotNumber="0" />
                        <local:HelmSlot Grid.Column="3" Opacity="1" Margin="1" SlotNumber="1" />
                        <local:HelmSlot Grid.Column="4" Opacity="1" Margin="1" SlotNumber="2" />
                        <local:HelmSlot Grid.Column="5" Opacity="1" Margin="1" SlotNumber="3" />
                        <local:HelmSlot Grid.Column="6" Opacity="1" Margin="1" SlotNumber="4" />
                    </Grid>
                    <Grid Grid.Column="1" Margin="8,1,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width=".3*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="KRoolLabel" Source="Images/dk64/krool.png" Grid.Column="0" Margin="-1"/>
                        <local:BossSlot Grid.Column="2" Opacity="1" Margin="1" SlotNumber="0" />
                        <local:BossSlot Grid.Column="3" Opacity="1" Margin="1" SlotNumber="1" />
                        <local:BossSlot Grid.Column="4" Opacity="1" Margin="1" SlotNumber="2" />
                        <local:BossSlot Grid.Column="5" Opacity="1" Margin="1" SlotNumber="3" />
                        <local:BossSlot Grid.Column="6" Opacity="1" Margin="1" SlotNumber="4" />
                    </Grid>
                </Grid>
                <!-- Song Display -->
                <local:Song Grid.Row="8" Background="Transparent" Margin="3,-2,-1,3" Visibility="{Binding DataContext.IsSongDisplayEnabled, ElementName=MainWindowRoot, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}" />
            </Grid>
            <Grid Grid.Column="1" Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="MultipathColumns" Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Name="DirectItemHintGrid">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.HintDisplayMode, ElementName=MainWindowRoot, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:HintDisplayMode.DirectItemHints}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Name="DirectHintsThirdMain" Width="0*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Name="DirectHintsCol0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Name="DirectHintsCol0LastRow" Height="1*"/>
                        </Grid.RowDefinitions>
                        <local:HintPanel Grid.Row="0" HintPanelType="Isles" HintType="DIRECT_ITEM_HINT" x:Name="IslesPanel" Margin="3" Heading="ISLES" LineColor="#fff67a" RegionName="DK_ISLES" />
                        <local:HintPanel Grid.Row="1" HintPanelType="Aztec" HintType="DIRECT_ITEM_HINT" x:Name="AztecPanel" Margin="3" Heading="AZTEC" LineColor="#ffb01f" RegionName="ANGRY_AZTEC" />
                        <local:HintPanel Grid.Row="2" HintPanelType="Galleon" HintType="DIRECT_ITEM_HINT" x:Name="GalleonPanel" Margin="3" Heading="GALLEON" LineColor="#216fff" RegionName="GLOOMY_GALLEON" />
                        <local:HintPanel Grid.Row="3" HintPanelType="Caves" HintType="DIRECT_ITEM_HINT" x:Name="CavesPanel" Margin="3" Heading="CAVES" LineColor="#42ddf5" RegionName="CRYSTAL_CAVES" />
                    </Grid>
                    <Grid Name="DirectHintsCol1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Name="DirectHintsCol1LastRow" Height="1*"/>
                        </Grid.RowDefinitions>
                        <local:HintPanel Grid.Row="0" HintPanelType="Japes" HintType="DIRECT_ITEM_HINT" x:Name="JapesPanel" Margin="3" Heading="JAPES" LineColor="#59ff64" RegionName="JUNGLE_JAPES" />
                        <local:HintPanel Grid.Row="1" HintPanelType="Factory" HintType="DIRECT_ITEM_HINT" x:Name="FactoryPanel" Margin="3" Heading="FACTORY" LineColor="#eeeeee" RegionName="FRANTIC_FACTORY" />
                        <local:HintPanel Grid.Row="2" HintPanelType="Forest" HintType="DIRECT_ITEM_HINT" x:Name="ForestPanel" Margin="3" Heading="FOREST" LineColor="#006b3e" RegionName="FUNGI_FOREST" />
                        <local:HintPanel Grid.Row="3" HintPanelType="Castle" HintType="DIRECT_ITEM_HINT" x:Name="CastlePanel" Margin="3" Heading="CASTLE" LineColor="#99a3ad" RegionName="CREEPY_CASTLE" />
                    </Grid>
                    <Grid Name="DirectHintsCol2" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>


                    </Grid>
                </Grid>
                <Grid Grid.Column="0" Name="MultipathGrid">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.HintDisplayMode, ElementName=MainWindowRoot, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:HintDisplayMode.MultipathHints}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Name="MultipathColumn2" Width="0*"/>
                    </Grid.ColumnDefinitions>
                    <local:HintPanel HintPanelType="Paths" HintType="PATH" x:Name="PathsPanel" Margin="3" Grid.Column="0" Heading="PATHS" LineColor="#dba512"  />
                    <Grid Name="MultipathColumn1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Name="MultipathColumn1Row0" Height="1.6*"/>
                            <RowDefinition Height="1.25*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <local:HintPanel Grid.Row="0" HintPanelType="Foolish" HintType="FOOLISH_REGION" x:Name="FoolishPanel" Margin="3" Heading="FOOLISH REGIONS" LineColor="#e02f2f"  />
                        <local:HintPanel Grid.Row="1" HintPanelType="Kongs" HintType="KONGS" x:Name="KongsPanel" Margin="3" Heading="KONGS" LineColor="#ff59e1"  />
                        <local:HintPanel Grid.Row="2" HintPanelType="WayOfTheHoard" HintType="WAY_OF_THE_HOARD" x:Name="WotHPanel" Margin="3" Heading="WAY OF THE HOARD" LineColor="#2652ff"  />
                    </Grid>
                    <Grid Name="MultipathMainColumn2"  Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                    </Grid>
                </Grid>
                <Grid Name="UnhintedColumn" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Name="OptionalPotionsRow" Height="2.54*"/>
                        <RowDefinition Height="5*"/>
                        <RowDefinition Height="2.6*"/>
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="{x:Type RowDefinition}">
                                    <Setter Property="Height" Value="0*" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHelmDoorPanelEnabled}" Value="True">
                                            <Setter Property="Height" Value="1*" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                    </Grid.RowDefinitions>
                    <local:HintPanel Grid.Row="0" HintPanelType="Helm" HintType="DIRECT_ITEM_HINT" x:Name="HelmPanel" Margin="3" Heading="HELM" LineColor="#b580ff" RegionName="HIDEOUT_HELM">
                        <local:HintPanel.Style>
                            <Style TargetType="{x:Type local:HintPanel}">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HintDisplayMode, ElementName=MainWindowRoot, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:HintDisplayMode.DirectItemHints}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:HintPanel.Style>
                    </local:HintPanel>
                    <local:HintPanel Grid.Row="0" HintPanelType="PotionCounts" HintType="REGION_POTION_COUNT" x:Name="PotionCountsPanel" Margin="3" Heading="POTION COUNTS" LineColor="#D0D0D0"  />
                    <local:HintPanel Grid.Row="1" HintPanelType="Unhinted" HintType="UNHINTED" x:Name="UnhintedPanel" Margin="3" Heading="UNHINTED MOVES" LineColor="#36f77d"  />
                    <hints:BLockerPanel x:Name="BLockerHints" Grid.Row="2" Margin="3" Heading="B. LOCKERS" LineColor="#F0F000"/>
                    <hints:HelmDoorPanel x:Name="HelmDoorHints" Grid.Row="3" Margin="3" Heading="HELM DOORS" LineColor="#7d3cbd" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
